<div class="auth-page snm-wrapper">
  <div class="snm-container standalone-form">
    <h1>Create an Account</h1>

    <p class="auth-alt center">
      Already have an account? <a href="/login?next=<%= signup.next %>">Log in here</a>.
    </p>
    <p class="auth-scistarter center">
      Do you have a <img src="/static/img/scistarter-logo.svg" alt="SciStarter"> account?
      <a href="/login-scistarter?next=<%= signup.next %>">Log in with your SciStarter account</a>.
    </p>

    <% include!("../partials/signup_form.stpl"); %>
  </div>
</div>
