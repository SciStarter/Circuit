<div class="my snm-wrapper">
  <div class="snm-container">
    <div class="my-saved">
      <h1>Saved Science Opportunities</h1>

      <section id="manage">
        <form class="saved-search" action="/my/saved" method="get">
          <label for="saved-search-text">Search your saved opportunities</label>
          <div class="saved-search-row">
            <input id="saved-search-text" name="search" type="text" value="<%= search %>" autocomplete="off">
            <% if sort != "closest" { %><input type="hidden" name="sort" value="<%= sort %>"><% } %>
            <button type="submit" class="action-button">Search</button>
          </div>
        </form>

        <form action="/my/saved/remove-old" method="post"
              hx-post="/my/saved/remove-old" hx-target="#saved-results" hx-swap="outerHTML"
              hx-confirm="Remove all past opportunities from your saved list?">
          <input type="hidden" name="search" value="<%= search %>">
          <input type="hidden" name="sort" value="<%= sort %>">
          <button type="submit" class="remove-old">
            <img src="/static/img/trash.svg" alt=""> Remove Past Opportunities
          </button>
        </form>
      </section>

      <section id="sort">
        <form action="/my/saved" method="get" class="sort-form">
          <% if !search.is_empty() { %><input type="hidden" name="search" value="<%= search %>"><% } %>
          <label>Sort:
            <select name="sort" onchange="this.form.submit()">
              <option value="closest" <% if sort == "closest" { %>selected<% } %>>Closest</option>
              <option value="soonest" <% if sort == "soonest" { %>selected<% } %>>Soonest</option>
            </select>
          </label>
        </form>
      </section>

      <section id="results">
        <%- results_html %>
      </section>
    </div>
  </div>
</div>
