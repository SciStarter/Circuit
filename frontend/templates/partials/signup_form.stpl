<% if let Some(err) = &signup.error { %>
  <div class="form-error"><%- err %></div>
<% } %>
<form class="auth-form" action="/signup" method="post">
  <input type="hidden" name="next" value="<%= signup.next %>">
  <label class="field">
    <span>Email <span class="has-required">*</span></span>
    <input type="email" name="email" autocomplete="email" value="<%= signup.email %>" required>
  </label>
  <label class="field">
    <span>Username <span class="has-required">*</span></span>
    <input type="text" name="username" autocomplete="username" value="<%= signup.username %>" required>
  </label>
  <label class="field">
    <span>Password <span class="has-required">*</span></span>
    <input type="password" name="password" autocomplete="new-password" minlength="7" required>
  </label>
  <label class="field">
    <span>Repeat Password <span class="has-required">*</span></span>
    <input type="password" name="password_repeat" autocomplete="new-password" minlength="7" required>
  </label>
  <label class="field">
    <span>Zip/Postal Code</span>
    <input type="text" name="zip_code" autocomplete="postal-code" value="<%= signup.zip_code %>">
  </label>
  <label class="field">
    <span>Phone <span class="has-optional">optional</span></span>
    <input type="tel" name="phone" autocomplete="tel" value="<%= signup.phone %>">
  </label>
  <label class="check">
    <input type="checkbox" name="agree" value="1" <% if signup.agree { %>checked<% } %>>
    <span>I agree to the <a href="/terms" target="_blank">Terms of Service</a>, <a href="/privacy" target="_blank">Privacy Policy</a>, and <a href="/research-participant" target="_blank">Research Participation Agreement</a>.</span>
  </label>
  <label class="check">
    <input type="checkbox" name="newsletter" value="1" <% if signup.newsletter { %>checked<% } %>>
    <span>Sign up for the Science Near Me Newsletter</span>
  </label>
  <div class="form-actions">
    <button type="submit" class="action-button primary">Sign up</button>
  </div>
</form>
