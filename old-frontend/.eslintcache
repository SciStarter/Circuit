      }\n                                else {\n                                    a.push(10);\n                                }\n                            }\n                        });\n                    arr.push(a);\n                });\n\n            \n\n                return arr;\n            }\n        },\n    \n        watch: {\n            chart_data() {\n                if(this.chart === null) {\n                    return;\n                }\n    \n                this.set_chart()\n            },\n            metric(){\n                this.set_chart()\n            }\n        },",[982,982],[1004,1004],[1022,1049],"const data = this.chart_data;",[1066,1091],"const metric = this.metric;",[1108,1121],"const arr = [];",[1139,1304],"const fields = ['citizen_science','formal_education','live_science','maker','museum_or_science_center','out_of_school_time_program','policy','science_communications'];",[1171,1171],[1190,1190],[1205,1205],[1213,1213],[1240,1240],[1269,1269],[1278,1278],[1338,1338],[1337,1338],"(d)",[1340,1340],[1362,1373],"const a = [];",[1414,1414],[1413,1414],"(e)",[1416,1416],[1770,1803],[2004,2016],[2003,2017],[2071,2075],[2171,2175],[2220,2222],[2238,2263],"const matrix = this.matrix;",[2281,2306],[2324,2357],"const chart_data = this.chart_data;",[2358,2359],[2502,2504],[2501,2501],[2626,2631],"'svg'",[2663,2672],"'viewBox'",[2730,2751],"'preserveAspectRatio'",[2752,2752],[2752,2762],"'xMinYMid'",[2794,2801],"'style'",[2803,2854],"'max-width: 100%; height: auto; height: intrinsic;'",[2886,2892],"'fill'",[2894,2908],"'currentColor'",[2940,2951],"'font-size'",[2987,3000],"'font-family'",[3002,3014],"'sans-serif'",[3046,3059],"'text-anchor'",[3061,3069],"'middle'",[3101,3105],"'id'",[3106,3106],[3106,3113],"'chord'",[3164,3167],"'g'",[3200,3211],"'transform'",[3213,3225],"'translate('",[3240,3243],[3259,3262],"')'",[3336,3337],"- ",[3451,3451],[3470,3470],[3485,3485],[3493,3493],[3520,3520],[3549,3549],[3558,3558],[3645,3645],[3664,3664],[