   <a v-else-if=\"traffic_top_order == 'average_time_asc'\" @click=\"traffic_top_order = 'average_time_desc'\"><i class=\"sort sort-desc\"><sort-icon /></i></a> -->\n  <!--           <a v-else @click=\"traffic_top_order = 'average_time_desc'\"><i class=\"sort sortable\"><sortable-icon /></i></a> -->\n  <!--         </th> -->\n  <!--       </tr> -->\n  <!--     </thead> -->\n  <!--     <tbody> -->\n  <!--       <tr v-for=\"row in traffic_top_sorted\"> -->\n  <!--         <td>{{row['name'] || row['type_'] || '[unavailable]'}}</td> -->\n  <!--         <td class=\"table-num\">{{row['Unique Users']}}</td> -->\n  <!--         <td class=\"table-bar\"><comparison-bar :value=\"row['Unique Users']\" :max=\"report[org].traffic.data.max['Unique Users']\" color=\"#268699\" /></td> -->\n  <!--         <td class=\"table-num\">{{row['New Users']}}</td> -->\n  <!--         <td class=\"table-bar\"><comparison-bar :value=\"row['New Users']\" :max=\"report[org].traffic.data.max['New Users']\" color=\"#268699\" /></td> -->\n  <!--         <td class=\"table-num\">{{row['Returning Users']}}</td> -->\n  <!--         <td class=\"table-bar\"><comparison-bar :value=\"row['Returning Users']\" :max=\"report[org].traffic.data.max['Returning Users']\" color=\"#268699\" /></td> -->\n  <!--         <td class=\"table-num\">{{row['Total Pageviews']}}</td> -->\n  <!--         <td class=\"table-bar\"><comparison-bar :value=\"row['Total Pageviews']\" :max=\"report[org].traffic.data.max['Total Pageviews']\" color=\"#268699\" /></td> -->\n  <!--         <td class=\"table-num\">{{row['Unique Pageviews']}}</td> -->\n  <!--         <td class=\"table-bar\"><comparison-bar :value=\"row['Unique Pageviews']\" :max=\"report[org].traffic.data.max['Unique Pageviews']\" color=\"#268699\" /></td> -->\n  <!--         <td class=\"table-num\">{{(row['Avg. Time'] / 1000).toFixed(2)}}</td> -->\n  <!--         <td class=\"table-bar\"><comparison-bar :value=\"row['Avg. Time']\" :max=\"report[org].traffic.data.max['Avg. Time']\" color=\"#268699\" /></td> -->\n  <!--       </tr> -->\n  <!--     </tbody> -->\n  <!--   </table> -->\n  <!-- </div> -->\n  </div>\n\n</div>\n</template>\n\n<script>\n\nimport EyeIcon from '~/assets/img/eye.svg?inline'\nimport LinkIcon from '~/assets/img/link.svg?inline'\nimport SortIcon from '~/assets/img/sort.svg?inline'\nimport SortableIcon from '~/assets/img/sortable.svg?inline'\n\nfunction cmp(a, b) {\n    if(a > b) {\n        return 1;\n    }\n    else if(a < b) {\n        return -1;\n    }\n    else {\n        return 0;\n    }\n}",[31096,31112],"'MyDataOverview'",[31114,31118],[31218,31222],[31441,31442],[31461,31465],[31560,31568],[31689,31714],[31741,31749],[31799,31831],"'/api/ui/organization/analytics'",[31869,31900],"const metro_groups = {'all': []};",[31889,31889],[31889,31894],"all",[31898,31898],[31921,31923],[31950,31958],[31971,31979],[32009,32032],"'/api/ui/finder/metros'",[32144,32151],".all",[32397,32405],[32462,32469],[32544,32650],"const local_searches = await context.$axios.$get(\"/api/ui/finder/metro-searches\", context.store.state.auth);",[32591,32622],"'/api/ui/finder/metro-searches'",[33301,33315],"'Unique Users'",[33342,33347],"'all'",[33377,33382],[33862,33894],[33897,33897],[33906,33906],[33961,33973],"'This Month'",[33983,34000],"'Live and Closed'",[34000,34000],[34028,34028],[34139,34156],[34672,34685],[34966,34979],[35254,35267],[35366,35379],[35454,35455],[35472,35481],"const state",[35531,35534],"'_'",[35692,35698],"name","'name'",[35727,35741],[35747,35761],[35784,35795],"'New Users'",[35801,35812],[35835,35852],"'Returning Users'",[35858,35875],[35898,35915],"'Total Pageviews'",[35921,35938],[35961,35979],"'Unique Pageviews'",[35985,36003],[36026,36037],"'Avg. Time'",[36043,36054],[36055,36056],[36217,36225],"'mobile'",[36227,36235],"'tablet'",[36237,36246],"'desktop'",[36260,36273],[36291,36299],"const tech",[36436,36442],[36470,36484],[36490,36504],[36527,36538],[36544,36555],[36578,36595],[36601,36618],[36641,36658],[36664,36681],[36704,36722],[36728,36746],[36769,36780],[36786,36797],[36798,36799],[36956,36964],[36966,36974],[36976,36985],[37016,37025],"'#165E6F'",[37027,37036],"'#7CB4BF'",[37038,37047],"'#D6D6D6'",[37078,37092],[37094,37105],[37107,37124],[37126,37143],[37145,37163],[37165,37176],[37192,37279],"const ret = {\n                labels: techs,\n                datasets: [],\n            };",[37263,37264],[37297,37306],"const field",[37349,37363],[37432,37611],"const dataset = {\n                    label: field,\n                    hoverOffset: 4,\n                    backgroundColor: colors,\n                    data: [],\n                };",[37591,37592],[37633,37641],[37999,38017],"'total_views_desc'",[38115,38124],".Views",[38127,38136],[38161,38178],"'total_views_asc'",[38275,38284],[38287,38296],[38321,38340],"'unique_views_desc'",[38438,38448],".Unique",[38451,38461],[38486,38504],"'unique_views_asc'",[38601,38611],[38614,38624],[38649,38662],"'clicks_desc'",[38830,38842],"'clicks_asc'",[39202,39220],"'unique_users_asc'",[39353,39372],"'unique_users_desc'",[39506,39521],"'new_users_asc'",[39648,39664],"'new_users_desc'",[39792,39813],"'returning_users_asc'",[39952,39974],"'returning_users_desc'",[40114,40135],"'total_pageviews_asc'",[40274,40296],"'total_pageviews_desc'",[40436,40458],"'unique_pageviews_asc'",[40599,40622],"'unique_pageviews_desc'",[40764,40782],"'average_time_asc'",[40909,40928],"'average_time_desc'",[41233,41251],[41388,41407],[41545,41560],[41691,41707],[41839,41860],[42003,42025],[42169,42190],[42333,42355],[42499,42521],[42666,42689],[42835,42853],[42984,43003],[43310,43328],[43482,43501],[43656,43671],[43819,43835],[43984,44005],[44165,44187],[44348,44369],[44529,44551],[44712,44734],[44896,44919],[45082,45100],[45248,45267],[45508,45509],[45980,46011],[46485,46498],[46697,46697],[46712,46712],[46764,46796],[46799,46799],[46808,46808],[46842,46842],[46870,46870],[47096,47157],"const structured = this.report[this.org].engagement.data.chart;",[48048,48106],"const structured = this.report[this.org].traffic.data.chart;",[48966,48966],[48987,48992],[48993,48993],[49184,49185],[54019,54020],[135,145],"'PieChart'",[263,264],[345,346],[356,357],[417,418],[418,420],[568,569],[898,899],[925,926],[932,933],[188,234],"'~/assets/geo/simplified-territories-usa.json'",[263,281],"'ChoroplethStates'",[399,400],[505,507],[507,508],[518,519],[579,580],[683,720],"const states = structuredClone(STATES);",[772,773],"(f)",[938,955],[1213,1218],"const f",[1419,1420],[1453,1709],"const map = this.map = new mapboxgl.Map({\n            accessToken: this.$config.mapboxToken,\n            container: this.$refs.display,\n            style: 'mapbox://styles/mapbox/streets-v11',\n            center: [-98, 39],\n            zoom: 2.5,\n        });",[1696,1697],[1790,1790],[1824,1824],[1985,1985],[2006,2006],[2300,2301],[2327,2328],[2392,2393],[2411,2412],[3510,3511],[150,196],[225,243],"'ActivityRegional'",[351,365],"'Pennsylvania'",[365,366],[480,481],[585,599],[599,600],[610,611],[671,672],[896,902],"'type'",[904,923],"'FeatureCollection'",[941,951],"features","'features'",[1041,1047],[1049,1058],"'Feature'",[1080,1090],"'geometry'",[1118,1124],[1126,1133],[1159,1172],"coordinates","'coordinates'",[1184,1185],[1229,1241],"'properties'",[1328,1329],[1349,1350],[1375,1376],[1895,2170],"const map = this.map = new mapboxgl.Map({\n            accessToken: this.$config.mapboxToken,\n            container: this.$refs.display,\n            style: 'mapbox://styles/mapbox/streets-v11',\n            bounds: bounds,\n            fitBoundsOptions: {padding: 20},\n        });",[2098,2112],"bounds",[2145,2145],[2156,2156],[2157,2158],[2253,2253],[2294,2294],[2344,2344],[2387,2387],[2550,2550],[2571,2571],[2572,2573],[2626,2640],[2642,2653],[2655,2672],[2674,2691],[2693,2711],[2713,2724],[2820,2829],"'heatmap'",[2859,2876],"'region-features'",[2932,2944],"visibility",[2991,2992],[3069,3085],"'heatmap-radius'",[3115,3131],"'heatmap-weight'",[3134,3139],"'get'",[3176,3191],"'heatmap-color'",[3194,3207],"'interpolate'",[3208,3208],[3209,3217],"'linear'",[3219,3219],[3220,3237],"'heatmap-density'",[3239,3239],[3242,3260],"'rgba(0, 0, 0, 0)'",[3266,3266],[3266,3289],"'rgba(65,105,225, 0.5)'",[3290,3290],[3292,3292],[3292,3314],"'rgba(0,255,255, 0.5)'",[3389,3390],[1393,1394],[3396,3397],[4026,4027],[4655,4656],[27432,27433],[30047,30052],[30093,30098],[30180,30180],[30232,30232],[30284,30284],[30344,30344],[0,30396],"<template>\n<div class=\"your-data-overview\">\n  <div class=\"flex-header\">\n    <h1>Opportunity Data Explorer</h1>\n  </div>\n\n  <div class=\"filters\">\n    <div class=\"stack\">\n      <label>Opportunity</label>\n      <b-select :value=\"current_opp\" @input=\"load_opp($event)\">\n        <option v-for=\"opp in opps\" :key=\"opp.id\" :value=\"opp\">\n          {{opp.title}}\n        </option>\n      </b-select>\n    </div>\n  </div>\n\n  <div class=\"nav-mobile-wrapper\">\n  <div class=\"nav-tab-wrapper\">\n    <ul class=\"nav-tabs nav-tabs-alt\">\n      <li><a class=\"tab-link\" :class=\"{'active':state=='engagement'}\" @click=\"state='engagement'\"><span>Engagement</span><small>How users interact with your opportunity</small></a></li>\n      <li><a class=\"tab-link\" :class=\"{'active':state=='states'}\" @click=\"state='states'\"><span>Audience</span><small>Demographics, locations and technology of your users</small></a></li>\n      <li><a class=\"tab-link\" :class=\"{'active':state=='traffic'}\" @click=\"state='traffic'\"><span>Traffic</span><small>How users get to your opportunity</small></a></li>\n      <li><a class=\"tab-link\" :class=\"{'active':state=='overlap'}\" @click=\"state='overlap'\"><span>Engagement Overlap</span><small>See how your users interact with other opportunities</small></a></li>\n    </ul>\n  </div>\n</div>\n\n  <aside class=\"data-update\">Date updated: {{updated_local}}</aside>\n\n  <div v-if=\"state=='engagement'\">\n\n\n    <h2>{{current_opp.title}}</h2>\n    <div class=\"filters\">\n      <div class=\"stack\">\n        <label>Time Period</label>\n        <b-select :value=\"report.engagement.data.time_period\" @input=\"load_data_into(current_opp.uid, 0, $event, 'Live and Closed', 'engagement')\">\n          <option v-for=\"period in report.engagement.time_periods\" :key=\"period\" :value=\"period\">\n            {{period}}\n          </option>\n        </b-select>\n      </div>\n    </div>\n\n    <div class=\"data-wrapper\">\n      <div class=\"data-header\">\n      <div class=\"big-legend bl-blue\">\n          <div class=\"ll-icon\"><eye-icon></eye-icon></div>\n          <div>\n            <h2>{{ report.engagement.data.bars.self[\"Views\"] }}</h2>\n            <h3>Page Views</h3>\n          </div>\n\n      </div>\n      <div class=\"ll-legend\">\n              <div><span class=\"dark-blue\"></span> Total</div>\n              <div><span class=\"light-blue\"></span> Unique</div>\n            </div>\n        </div>\n        <line-chart\n          :rows=\"report.engagement.data.chart\"\n          :xaxis=\"d => new Date(d.date)\"\n          :yaxes=\"['Views', 'Unique']\"\n          :colors=\"['#268699', '#BFDCE2']\"\n          />\n    </div>\n\n    <div class=\"data-wrapper\">\n      <div class=\"data-header\">\n      <div class=\"big-legend bl-yellow\">\n          <div class=\"ll-icon\"><link-icon></link-icon></div>\n          <div>\n            <h2>{{ report.engagement.data.bars.self[\"Clicks to Website\"] }}</h2>\n            <h3>Clicks To Your Website</h3>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"data-header2\">\n        <h4>Conversion Rates</h4><small>based on total page views</small>\n      </div>\n      <div class=\"conversion-rate\">\n        <h5>Your Conversion Rate</h5>\n        <div class=\"flex align-center\">\n        <comparison-bar :value=\"report.engagement.data.bars.self['Views'] > 0 ? report.engagement.data.bars.self['Clicks to Website'] / report.engagement.data.bars.self['Views'] : 0\" :max=\"1.0\" color=\"#165E6F\" background=\"#DEDEDE\" width=\"100%\" height=\"2rem\" />\n          <span class=\"con-num\">{{report.engagement.data.bars.self['Views'] > 0 ? ((report.engagement.data.bars.self['Clicks to Website'] / report.engagement.data.bars.self['Views']) * 100).toFixed(2) : 0}}%</span>\n        </div>\n      </div>\n      <div class=\"conversion-rate\">\n        <h5>All SNM Opportunity Median</h5>\n        <div class=\"flex align-center\">\n        <comparison-bar :value=\"report.engagement.data.bars.median['Views'] > 0 ? report.engagement.data.bars.median['Clicks to Website'] / report.engagement.data.bars.median['Views'] : 0\" :max=\"1.0\" color=\"#7CB4BF\" background=\"#DEDEDE\" width=\"100%\" height=\"2rem\" />\n          <span class=\"con-num\">{{report.engagement.data.bars.median['Views'] > 0 ? ((report.engagement.data.bars.median['Clicks to Website'] / report.engagement.data.bars.median['Views'])*100).toFixed(2) : 0}}%</span>\n        </div>\n      </div>\n      <div class=\"conversion-rate\">\n        <h5>All SNM Opportunity Average</h5>\n        <div class=\"flex align-center\">\n        <comparison-bar :value=\"report.engagement.data.bars.mean['Views'] > 0 ? report.engagement.data.bars.mean['Clicks to Website'] / report.engagement.data.bars.mean['Views'] : 0\" :max=\"1.0\" color=\"#7CB4BF\" background=\"#DEDEDE\" width=\"100%\" height=\"2rem\" />\n          <span class=\"con-num\">{{report.engagement.data.bars.mean['Views'] > 0 ? ((report.engagement.data.bars.mean['Clicks to Website'] / report.engagement.data.bars.mean['Views'])*100).toFixed(2) : 0}}%</span>\n        </div>\n      </div>\n  </div>\n\n  </div>\n\n  <div v-else-if=\"state=='states'\">\n    <h2>Audience</h2>\n\n    <div class=\"notification\">\n      <label>Demographics Coming Soon!</label>\n      We are working on getting demographic data at the opportunity level. Right now you can view <nuxt-link to=\"/\">site-wide demographic data</nuxt-link>.\n    </div>\n\n    <div class=\"filters\">\n      <!-- <div class=\"stack\"> -->\n      <!--   <label>Opportunity Status</label> -->\n      <!--   <b-select :value=\"report.states.data.opportunity_status\" @input=\"log('TBD download from server')\"> -->\n      <!--     <option v-for=\"status in report.states.opportunity_statuses\" :key=\"status\" :value=\"status\"> -->\n      <!--       {{status}} -->\n      <!--     </option> -->\n      <!--   </b-select> -->\n      <!-- </div> -->\n      <div class=\"stack\">\n        <label>Time Period</label>\n        <b-select :value=\"report.states.data.time_period\" @input=\"load_data_into(current_opp.uid, 0, $event, 'Live and Closed', 'states')\">\n          <option v-for=\"period in report.states.time_periods\" :key=\"period\" :value=\"period\">\n            {{period}}\n          </option>\n        </b-select>\n      </div>\n    </div>\n\n    <choropleth-states v-if=\"selected_state === null\" :value=\"report.states.data.states\" attr=\"Unique Users\" @state=\"select_state($event)\"/>\n    <div v-else>\n      <a @click=\"selected_state = null\">← Back to US Map</a>\n      <b-select v-model=\"selected_attr\" placeholder=\"Select Data Type\">\n        <option>Unique Users</option>\n        <option>New Users</option>\n        <option>Returning Users</option>\n        <option>Total Pageviews</option>\n        <option>Unique Pageviews</option>\n        <option>Avg. Time</option>\n      </b-select>\n      <activity-regional :state=\"selected_state\" :data=\"selected_state_data\" :attr=\"selected_attr\" />\n    </div>\n\n    <div class=\"data-table-wrapper\">\n    <table class=\"data-table\">\n      <thead>\n        <tr>\n          <th>Engagement By Location</th>\n          <th colspan=\"2\">Unique Users <b-tooltip label=\"Individual users only counted once.\" position=\"is-top\" append-to-body multilined>\n          <b-button label=\"?\" />\n        </b-tooltip>\n            <a v-if=\"states_top_order == 'unique_users_desc'\" @click=\"states_top_order = 'unique_users_asc'\"><i class=\"sort sort-asc\"><sort-icon /></i></a>\n            <a v-else-if=\"states_top_order == 'unique_users_asc'\" @click=\"states_top_order = 'unique_users_desc'\"><i class=\"sort sort-desc\"><sort-icon /></i></a>\n            <a v-else @click=\"states_top_order = 'unique_users_desc'\"><i class=\"sort sortable\"><sortable-icon /></i></a>\n          </th>\n          <th colspan=\"2\">New Users <b-tooltip label=\"First time visitors.\" position=\"is-top\" append-to-body multilined>\n          <b-button label=\"?\" />\n        </b-tooltip>\n            <a v-if=\"states_top_order == 'new_users_desc'\" @click=\"states_top_order = 'new_users_asc'\"><i class=\"sort sort-asc\"><sort-icon /></i></a>\n            <a v-else-if=\"states_top_order == 'new_users_asc'\" @click=\"states_top_order = 'new_users_desc'\"><i class=\"sort sort-desc\"><sort-icon /></i></a>\n            <a v-else @click=\"states_top_order = 'new_users_desc'\"><i class=\"sort sortable\"><sortable-icon /></i></a>\n          </th>\n          <th colspan=\"2\">Returning Users <b-tooltip label=\"Visitors who have viewed more than once.\" position=\"is-top\" append-to-body multilined>\n          <b-button label=\"?\" />\n        </b-tooltip>\n            <a v-if=\"states_top_order == 'returning_users_desc'\" @click=\"states_top_order = 'returning_users_asc'\"><i class=\"sort sort-asc\"><sort-icon /></i></a>\n            <a v-else-if=\"states_top_order == 'returning_users_asc'\" @click=\"states_top_order = 'returning_users_desc'\"><i class=\"sort sort-desc\"><sort-icon /></i></a>\n            <a v-else @click=\"states_top_order = 'returning_users_desc'\"><i class=\"sort sortable\"><sortable-icon /></i></a>\n          </th>\n          <th colspan=\"2\">Total Pageviews <b-tooltip label=\"The amount of times your page was viewed.\" position=\"is-top\" append-to-body multilined>\n          <b-button label=\"?\" />\n        </b-tooltip>\n            <a v-if=\"states_top_order == 'total_pageviews_desc'\" @click=\"states_top_order = 'total_pageviews_asc'\"><i class=\"sort sort-asc\"><sort-icon /></i></a>\n            <a v-else-if=\"states_top_order == 'total_pageviews_asc'\" @click=\"states_top_order = 'total_pageviews_desc'\"><i class=\"sort sort-desc\"><sort-icon /></i></a>\n            <a v-else @click=\"states_top_order = 'total_pageviews_desc'\"><i class=\"sort sortable\"><sortable-icon /></i></a>\n          </th>\n          <th colspan=\"2\">Unique Pageviews <b-tooltip label=\"Times the page was viewed by a unique user.\" position=\"is-top\" append-to-body multilined>\n          <b-button label=\"?\" />\n        </b-tooltip>\n            <a v-if=\"states_top_order == 'unique_pageviews_desc'\" @click=\"states_top_order = 'unique_pageviews_asc'\"><i class=\"sort sort-asc\"><sort-icon /></i></a>\n            <a v-else-if=\"states_top_order == 'unique_pageviews_asc'\" @click=\"states_top_order = 'unique_pageviews_desc'\"><i class=\"sort sort-desc\"><sort-icon /></i></a>\n            <a v-else @click=\"states_top_order = 'unique_pageviews_desc'\"><i class=\"sort sortable\"><sortable-icon /></i></a>\n          </th>\n          <th colspan=\"2\">Avg. Time <b-tooltip label=\"The average time spent on your page by users.\" position=\"is-top\" append-to-body multilined>\n          <b-button label=\"?\" />\n        </b-tooltip>\n            <a v-if=\"states_top_order == 'average_time_desc'\" @click=\"states_top_order = 'average_time_asc'\"><i class=\"sort sort-asc\"><sort-icon /></i></a>\n            <a v-else-if=\"states_top_order == 'average_time_asc'\" @click=\"states_top_order = 'average_time_desc'\"><i class=\"sort sort-desc\"><sort-icon /></i></a>\n            <a v-else @click=\"states_top_order = 'average_time_desc'\"><i class=\"sort sortable\"><sortable-icon /></i></a>\n          </th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr v-for=\"row in states_top_sorted\">\n          <td v-if=\"selected_state === null\"><a @click=\"select_state(row['name'])\">{{row['name']}}</a></td>\n          <td v-else>{{row['name']}}</td>\n          <td class=\"table-num\">{{row['Unique Users']}}</td>\n          <td class=\"table-bar\"><comparison-bar :value=\"row['Unique Users']\" :max=\"states_max['Unique Users']\" color=\"#268699\" /></td>\n          <td class=\"table-num\">{{row['New Users']}}</td>\n          <td class=\"table-bar\"><comparison-bar :value=\"row['New Users']\" :max=\"states_max['New Users']\" color=\"#268699\" /></td>\n          <td class=\"table-num\">{{row['Returning Users']}}</td>\n          <td class=\"table-bar\"><comparison-bar :value=\"row['Returning Users']\" :max=\"states_max['Returning Users']\" color=\"#268699\" /></td>\n          <td class=\"table-num\">{{row['Total Pageviews']}}</td>\n          <td class=\"table-bar\"><comparison-bar :value=\"row['Total Pageviews']\" :max=\"states_max['Total Pageviews']\" color=\"#268699\" /></td>\n          <td class=\"table-num\">{{row['Unique Pageviews']}}</td>\n          <td class=\"table-bar\"><comparison-bar :value=\"row['Unique Pageviews']\" :max=\"states_max['Unique Pageviews']\" color=\"#268699\" /></td>\n          <td class=\"table-num\">{{row['Avg. Time']}}</td>\n          <td class=\"table-bar\"><comparison-bar :value=\"row['Avg. Time']\" :max=\"states_max['Avg. Time']\" color=\"#268699\" /></td>\n        </tr>\n      </tbody>\n    </table>\n    </div>\n\n    <div class=\"data-wrapper crush\">\n      <div class=\"data-head\">\n        <h3>Technology</h3>\n        <b-select :value=\"report.technology.data.time_period\" @input=\"load_data_into(current_opp.uid, 0, $event, 'Live and Closed', 'technology')\">\n          <option v-for=\"period in report.technology.time_periods\" :key=\"period\" :value=\"period\">\n            {{period}}\n          </option>\n        </b-select>\n      </div>\n      <pie-chart :data=\"technology_pie\" doughnut />\n    </div>\n    <div class=\"data-table-wrapper\">\n      <table class=\"data-table\">\n        <thead>\n          <tr>\n            <th>Engagement By Device Type</th>\n            <th colspan=\"2\">Unique Users <b-tooltip label=\"Individual users only counted once.\" position=\"is-top\" append-to-body multilined>\n                <b-button label=\"?\" />\n              </b-tooltip>\n              <a v-if=\"technology_top_order == 'unique_users_desc'\" @click=\"technology_top_order = 'unique_users_asc'\"><i class=\"sort sort-asc\"><sort-icon /></i></a>\n              <a v-else-if=\"technology_top_order == 'unique_users_asc'\" @click=\"technology_top_order = 'unique_users_desc'\"><i class=\"sort sort-desc\"><sort-icon /></i></a>\n              <a v-else @click=\"technology_top_order = 'unique_users_desc'\"><i class=\"sort sortable\"><sortable-icon /></i></a>\n            </th>\n            <th colspan=\"2\">New Users <b-tooltip label=\"First time visitors.\" position=\"is-top\" append-to-body multilined>\n                <b-button label=\"?\" />\n              </b-tooltip>\n              <a v-if=\"technology_top_order == 'new_users_desc'\" @click=\"technology_top_order = 'new_users_asc'\"><i class=\"sort sort-asc\"><sort-icon /></i></a>\n              <a v-else-if=\"technology_top_order == 'new_users_asc'\" @click=\"technology_top_order = 'new_users_desc'\"><i class=\"sort sort-desc\"><sort-icon /></i></a>\n              <a v-else @click=\"technology_top_order = 'new_users_desc'\"><i class=\"sort sortable\"><sortable-icon /></i></a>\n            </th>\n            <th colspan=\"2\">Returning Users <b-tooltip label=\"Visitors who have viewed more than once.\" position=\"is-top\" append-to-body multilined>\n                <b-button label=\"?\" />\n              </b-tooltip>\n              <a v-if=\"technology_top_order == 'returning_users_desc'\" @click=\"technology_top_order = 'returning_users_asc'\"><i class=\"sort sort-asc\"><sort-icon /></i></a>\n              <a v-else-if=\"technology_top_order == 'returning_users_asc'\" @click=\"technology_top_order = 'returning_users_desc'\"><i class=\"sort sort-desc\"><sort-icon /></i></a>\n              <a v-else @click=\"technology_top_order = 'returning_users_desc'\"><i class=\"sort sortable\"><sortable-icon /></i></a>\n            </th>\n            <th colspan=\"2\">Total Pageviews <b-tooltip label=\"The amount of times your page was viewed.\" position=\"is-top\" append-to-body multilined>\n                <b-button label=\"?\" />\n              </b-tooltip>\n              <a v-if=\"technology_top_order == 'total_pageviews_desc'\" @click=\"technology_top_order = 'total_pageviews_asc'\"><i class=\"sort sort-asc\"><sort-icon /></i></a>\n              <a v-else-if=\"technology_top_order == 'total_pageviews_asc'\" @click=\"technology_top_order = 'total_pageviews_desc'\"><i class=\"sort sort-desc\"><sort-icon /></i></a>\n              <a v-else @click=\"technology_top_order = 'total_pageviews_desc'\"><i class=\"sort sortable\"><sortable-icon /></i></a>\n            </th>\n            <th colspan=\"2\">Unique Pageviews <b-tooltip label=\"Times the page was viewed by a unique user.\" position=\"is-top\" append-to-body multilined>\n                <b-button label=\"?\" />\n              </b-tooltip>\n              <a v-if=\"technology_top_order == 'unique_pageviews_desc'\" @click=\"technology_top_order = 'unique_pageviews_asc'\"><i class=\"sort sort-asc\"><sort-icon /></i></a>\n              <a v-else-if=\"technology_top_order == 'unique_pageviews_asc'\" @click=\"technology_top_order = 'unique_pageviews_desc'\"><i class=\"sort sort-desc\"><sort-icon /></i></a>\n              <a v-else @click=\"technology_top_order = 'unique_pageviews_desc'\"><i class=\"sort sortable\"><sortable-icon /></i></a>\n            </th>\n            <th colspan=\"2\">Avg. Time <b-tooltip label=\"The average time spent on your page by users.\" position=\"is-top\" append-to-body multilined>\n                <b-button label=\"?\" />\n              </b-tooltip>\n              <a v-if=\"technology_top_order == 'average_time_desc'\" @click=\"technology_top_order = 'average_time_asc'\"><i class=\"sort sort-asc\"><sort-icon /></i></a>\n              <a v-else-if=\"technology_top_order == 'average_time_asc'\" @click=\"technology_top_order = 'average_time_desc'\"><i class=\"sort sort-desc\"><sort-icon /></i></a>\n              <a v-else @click=\"technology_top_order = 'average_time_desc'\"><i class=\"sort sortable\"><sortable-icon /></i></a>\n            </th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr v-for=\"row in technology_top_sorted\">\n            <td>{{row['name']}}</td>\n            <td class=\"table-num\">{{row['Unique Users']}}</td>\n            <td class=\"table-bar\"><comparison-bar :value=\"row['Unique Users']\" :max=\"report.technology.data.max['Unique Users']\" color=\"#268699\" /></td>\n            <td class=\"table-num\">{{row['New Users']}}</td>\n            <td class=\"table-bar\"><comparison-bar :value=\"row['New Users']\" :max=\"report.technology.data.max['New Users']\" color=\"#268699\" /></td>\n            <td class=\"table-num\">{{row['Returning Users']}}</td>\n            <td class=\"table-bar\"><comparison-bar :value=\"row['Returning Users']\" :max=\"report.technology.data.max['Returning Users']\" color=\"#268699\" /></td>\n            <td class=\"table-num\">{{row['Total Pageviews']}}</td>\n            <td class=\"table-bar\"><comparison-bar :value=\"row['Total Pageviews']\" :max=\"report.technology.data.max['Total Pageviews']\" color=\"#268699\" /></td>\n            <td class=\"table-num\">{{row['Unique Pageviews']}}</td>\n            <td class=\"table-bar\"><comparison-bar :value=\"row['Unique Pageviews']\" :max=\"report.technology.data.max['Unique Pageviews']\" color=\"#268699\" /></td>\n            <td class=\"table-num\">{{row['Avg. Time']}}</td>\n            <td class=\"table-bar\"><comparison-bar :value=\"row['Avg. Time']\" :max=\"report.technology.data.max['Avg. Time']\" color=\"#268699\" /></td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n  </div>\n\n  <div v-else-if=\"state=='traffic'\">\n    <h2>Traffic</h2>\n\n    <div class=\"filters\">\n      <!-- <div class=\"stack\"> -->\n      <!--   <label>Opportunity Status</label> -->\n      <!--   <b-select :value=\"report.engagement.data.opportunity_status\" @input=\"log('TBD download from server')\"> -->\n      <!--     <option v-for=\"status in report.engagement.opportunity_statuses\" :key=\"status\" :value=\"status\"> -->\n      <!--       {{status}} -->\n      <!--     </option> -->\n      <!--   </b-select> -->\n      <!-- </div> -->\n      <div class=\"stack\">\n        <label>Time Period</label>\n        <b-select :value=\"report.traffic.data.time_period\" @input=\"load_data_into(current_opp.uid, 0, $event, 'Live and Closed', 'traffic')\">\n          <option v-for=\"period in report.traffic.time_periods\" :key=\"period\" :value=\"period\">\n            {{period}}\n          </option>\n        </b-select>\n      </div>\n      <div class=\"extra\">\n        <a @click=\"save_traffic_csv\">export csv</a>\n      </div>\n    </div>\n\n    <div class=\"data-wrapper\">\n      <div class=\"data-header\">\n        <div class=\"big-legend bl-blue\">\n          <div class=\"ll-icon ll-icon-user\"><user-icon></user-icon></div>\n          <div>\n            <h2># (Total Unique Users during time period)</h2>\n            <h3>Users</h3>\n\n          </div>\n        </div>\n        <div class=\"ll-legend\">\n              <div><span class=\"dark-blue\"></span> Unique</div>\n              <div><span class=\"light-blue\"></span> New</div>\n              <div><span class=\"light-blue\"></span> Returning</div>\n            </div>\n        </div>\n    <line-chart\n      :rows=\"report.traffic.data.chart\"\n      :xaxis=\"d => new Date(d.date)\"\n      :yaxes=\"['Unique', 'New', 'Returning']\"\n      :colors=\"['#268699', '#868686', '#BFDCE2']\"\n      />\n    </div>\n\n    <div class=\"data-wrapper crush\">\n      <div class=\"data-head\">\n          <h3>Referral Sources</h3>\n        </div>\n    <pie-chart :data=\"report.traffic.data.pie\" />\n      </div>\n      <div class=\"data-table-wrapper\">\n\n    <table class=\"data-table\">\n      <thead>\n        <tr>\n          <th>Top Referrers</th>\n          <th colspan=\"2\">Unique Users <b-tooltip label=\"Individual users only counted once.\" position=\"is-top\" append-to-body multilined>\n          <b-button label=\"?\" />\n        </b-tooltip>\n            <a v-if=\"traffic_top_order == 'unique_users_desc'\" @click=\"traffic_top_order = 'unique_users_asc'\"><i class=\"sort sort-asc\"><sort-icon /></i></a>\n            <a v-else-if=\"traffic_top_order == 'unique_users_asc'\" @click=\"traffic_top_order = 'unique_users_desc'\"><i class=\"sort sort-desc\"><sort-icon /></i></a>\n            <a v-else @click=\"traffic_top_order = 'unique_users_desc'\"><i class=\"sort sortable\"><sortable-icon /></i></a>\n          </th>\n          <th colspan=\"2\">New Users <b-tooltip label=\"First time visitors.\" position=\"is-top\" append-to-body multilined>\n          <b-button label=\"?\" />\n        </b-tooltip>\n            <a v-if=\"traffic_top_order == 'new_users_desc'\" @click=\"traffic_top_order = 'new_users_asc'\"><i class=\"sort sort-asc\"><sort-icon /></i></a>\n            <a v-else-if=\"traffic_top_order == 'new_users_asc'\" @click=\"traffic_top_order = 'new_users_desc'\"><i class=\"sort sort-desc\"><sort-icon /></i></a>\n            <a v-else @click=\"traffic_top_order = 'new_users_desc'\"><i class=\"sort sortable\"><sortable-icon /></i></a>\n          </th>\n          <th colspan=\"2\">Returning Users <b-tooltip label=\"Visitors who have viewed more than once.\" position=\"is-top\" append-to-body multilined>\n          <b-button label=\"?\" />\n        </b-tooltip>\n            <a v-if=\"traffic_top_order == 'returning_users_desc'\" @click=\"traffic_top_order = 'returning_users_asc'\"><i class=\"sort sort-asc\"><sort-icon /></i></a>\n            <a v-else-if=\"traffic_top_order == 'returning_users_asc'\" @click=\"traffic_top_order = 'returning_users_desc'\"><i class=\"sort sort-desc\"><sort-icon /></i></a>\n            <a v-else @click=\"traffic_top_order = 'returning_users_desc'\"><i class=\"sort sortable\"><sortable-icon /></i></a>\n          </th>\n          <th colspan=\"2\">Total Pageviews <b-tooltip label=\"The amount of times your page was viewed.\" position=\"is-top\" append-to-body multilined>\n          <b-button label=\"?\" />\n        </b-tooltip>\n            <a v-if=\"traffic_top_order == 'total_pageviews_desc'\" @click=\"traffic_top_order = 'total_pageviews_asc'\"><i class=\"sort sort-asc\"><sort-icon /></i></a>\n            <a v-else-if=\"traffic_top_order == 'total_pageviews_asc'\" @click=\"traffic_top_order = 'total_pageviews_desc'\"><i class=\"sort sort-desc\"><sort-icon /></i></a>\n            <a v-else @click=\"traffic_top_order = 'total_pageviews_desc'\"><i class=\"sort sortable\"><sortable-icon /></i></a>\n          </th>\n          <th colspan=\"2\">Unique Pageviews <b-tooltip label=\"Times the page was viewed by a unique user.\" position=\"is-top\" append-to-body multilined>\n          <b-button label=\"?\" />\n        </b-tooltip>\n            <a v-if=\"traffic_top_order == 'unique_pageviews_desc'\" @click=\"traffic_top_order = 'unique_pageviews_asc'\"><i class=\"sort sort-asc\"><sort-icon /></i></a>\n            <a v-else-if=\"traffic_top_order == 'unique_pageviews_asc'\" @click=\"traffic_top_order = 'unique_pageviews_desc'\"><i class=\"sort sort-desc\"><sort-icon /></i></a>\n            <a v-else @click=\"traffic_top_order = 'unique_pageviews_desc'\"><i class=\"sort sortable\"><sortable-icon /></i></a>\n          </th>\n          <th colspan=\"2\">Avg. Time <b-tooltip label=\"The average time spent on your page by users.\" position=\"is-top\" append-to-body multilined>\n          <b-button label=\"?\" />\n        </b-tooltip>\n            <a v-if=\"traffic_top_order == 'average_time_desc'\" @click=\"traffic_top_order = 'average_time_asc'\"><i class=\"sort sort-asc\"><sort-icon /></i></a>\n            <a v-else-if=\"traffic_top_order == 'average_time_asc'\" @click=\"traffic_top_order = 'average_time_desc'\"><i class=\"sort sort-desc\"><sort-icon /></i></a>\n            <a v-else @click=\"traffic_top_order = 'average_time_desc'\"><i class=\"sort sortable\"><sortable-icon /></i></a>\n          </th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr v-for=\"row in traffic_top_sorted\">\n          <td>{{row['name']}}</td>\n          <td class=\"table-num\">{{row['Unique Users']}}</td>\n          <td class=\"table-bar\"><comparison-bar :value=\"row['Unique Users']\" :max=\"report.traffic.data.max['Unique Users']\" color=\"#268699\" /></td>\n          <td class=\"table-num\">{{row['New Users']}}</td>\n          <td class=\"table-bar\"><comparison-bar :value=\"row['New Users']\" :max=\"report.traffic.data.max['New Users']\" color=\"#268699\" /></td>\n          <td class=\"table-num\">{{row['Returning Users']}}</td>\n          <td class=\"table-bar\"><comparison-bar :value=\"row['Returning Users']\" :max=\"report.traffic.data.max['Returning Users']\" color=\"#268699\" /></td>\n          <td class=\"table-num\">{{row['Total Pageviews']}}</td>\n          <td class=\"table-bar\"><comparison-bar :value=\"row['Total Pageviews']\" :max=\"report.traffic.data.max['Total Pageviews']\" color=\"#268699\" /></td>\n          <td class=\"table-num\">{{row['Unique Pageviews']}}</td>\n          <td class=\"table-bar\"><comparison-bar :value=\"row['Unique Pageviews']\" :max=\"report.traffic.data.max['Unique Pageviews']\" color=\"#268699\" /></td>\n          <td class=\"table-num\">{{row['Avg. Time']}}</td>\n          <td class=\"table-bar\"><comparison-bar :value=\"row['Avg. Time']\" :max=\"report.traffic.data.max['Avg. Time']\" color=\"#268699\" /></td>\n        </tr>\n      </tbody>\n    </table>\n  </div>\n  </div>\n  <div v-else-if=\"state=='overlap'\">\n    <div class=\"explain-header\">\n      <h2>Engagement Overlap</h2>\n    <small>See what people who engage with your Science Near Me page tend to engage with. </small>\n\n    </div>\n\n    <div class=\"data-wrapper\">\n\n      <div class=\"data-head\"><h3>Top 50</h3></div>\n\n      <div class=\"bubble-header\">\n      <!-- It turns out that only 'views' is a practicable calculation, so disable the ability to select other criteria -->\n      <!-- <div> -->\n      <!--   <label>Engagement Type</label> -->\n      <!--   <b-select :value=\"report.overlap.data.engagement_type\" @input=\"log('TBD download from server')\"> -->\n      <!--     <option v-for=\"e_type in report.overlap.engagement_types\" :key=\"e_type\" :value=\"e_type\"> -->\n      <!--       {{e_type}} -->\n      <!--     </option> -->\n      <!--   </b-select> -->\n      <!-- </div> -->\n\n      <div class=\"ll-legend\">\n          <div><span class=\"gray\"></span> {{current_opp.title}} (100% of users)</div>\n          <div><span class=\"dark-blue\"></span> Opportunity Owned By You</div>\n          <div><span class=\"light-blue\"></span> Opportunity Owned By Someone Else</div>\n        </div>\n      </div>\n\n      <bubble-chart :chart_data=\"report.overlap.data\" :org=\"current_opp.title\" :current_opp=\"current_opp\" />\n    </div>\n\n\n    <!-- Making this table sortable by different fields would be a\n    huge can of worms, since it brings up logic conflicts and\n    ambiguities. Seems like it should always be sorted by overlap\n    percent anyhow, so that's what I've done here. -->\n\n    <div class=\"data-table-wrapper\">\n    <table class=\"data-table\">\n      <thead>\n        <tr>\n          <th>Opportunity</th>\n          <th colspan=\"2\">Overlap Percent <b-tooltip label=\"The percent of users who veiwed both your opportunity and the listed opportunity.\" position=\"is-top\" append-to-body multilined>\n          <b-button label=\"?\" />\n        </b-tooltip></th>\n          <th>Hosted By <b-tooltip label=\"The host of the listed opportunity.\" position=\"is-top\" append-to-body multilined>\n          <b-button label=\"?\" />\n        </b-tooltip></th>\n          <th>Activity Types <b-tooltip label=\"The types of activities of the opportunity.\" position=\"is-top\" append-to-body multilined>\n          <b-button label=\"?\" />\n        </b-tooltip></th>\n          <th>Format <b-tooltip label=\"If the opportunity is event or On-Demand.\" position=\"is-top\" append-to-body multilined>\n          <b-button label=\"?\" />\n        </b-tooltip></th>\n          <th>Venue Types <b-tooltip label=\"If the opportunity is indoors or outdoors.\" position=\"is-top\" append-to-body multilined>\n          <b-button label=\"?\" />\n        </b-tooltip></th>\n          <th>Min. Age <b-tooltip label=\"Any minimum age set for participating in the opportunity.\" position=\"is-top\" append-to-body multilined>\n          <b-button label=\"?\" />\n        </b-tooltip></th>\n          <th>Max. Age <b-tooltip label=\"Any maximum age set for participating in the opportunity.\" position=\"is-top\" append-to-body multilined>\n          <b-button label=\"?\" />\n        </b-tooltip></th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr v-for=\"row in report.overlap.data.table\">\n          <td>{{row.name}}</td>\n          <td class=\"table-num\">{{percent(row.overlap)}}</td>\n          <td class=\"table-bar\"><comparison-bar :value=\"row.overlap\" :max=\"1.0\" color=\"#268699\" /></td>\n          <td>{{row.host}}</td>\n          <td>{{friendly(row.activity_types)}}</td>\n          <td>{{row.format}}</td>\n          <td>{{friendly(row.venue_types)}}</td>\n          <td v-if=\"row.min_age > 0\" >{{row.min_age}}</td>\n          <td v-else><small>N/A</small></td>\n          <td v-if=\"row.max_age < 999\">{{row.max_age}}</td>\n          <td v-else><small>N/A</small></td>\n        </tr>\n      </tbody>\n    </table>\n    </div>\n\n  </div>\n</div>\n</template>\n\n<script>\n\nimport EyeIcon from '~/assets/img/eye.svg?inline'\nimport LinkIcon from '~/assets/img/link.svg?inline'\nimport SortIcon from '~/assets/img/sort.svg?inline'\nimport SortableIcon from '~/assets/img/sortable.svg?inline'\nimport UserIcon from '~/assets/img/user.svg?inline'\nfunction cmp(a, b) {\n    if(a > b) {\n        return 1;\n    }\n    else if(a < b) {\n        return -1;\n    }\n    else {\n        return 0;\n    }\n}",[30424,30451],"'MyOpportunityDataExplorer'",[30468,30468],[30778,30779],[31014,31039],[31585,31603],"'No opportunities'",[31718,31750],[31865,31877],[31903,31920],[32067,32068],[32370,32384],[32384,32385],[32772,32785],[33046,33059],[33314,33327],[33426,33439],[33514,33515],[33532,33541],[33591,33594],[33752,33758],[33787,33801],[33807,33821],[33844,33855],[33861,33872],[33895,33912],[33918,33935],[33958,33975],[33981,33998],[34021,34039],[34045,34063],[34086,34097],[34103,34114],[34115,34116],[34277,34285],[34287,34295],[34297,34306],[34320,34333],[34351,34359],[34486,34492],[34520,34534],[34540,34554],[34577,34588],[34594,34605],[34628,34645],[34651,34668],[34691,34708],[34714,34731],[34754,34772],[34778,34796],[34819,34830],[34836,34847],[34848,34849],[35006,35014],[35016,35024],[35026,35035],[35066,35075],[35077,35086],[35088,35097],[35128,35142],[35144,35155],[35157,35174],[35176,35193],[35195,35213],[35215,35226],[35242,35329],[35313,35314],[35347,35356],[35399,35413],[35482,35661],[35641,35642],[35683,35691],[36031,36049],[36182,36201],[36335,36350],[36477,36493],[36621,36642],[36781,36803],[36943,36964],[37103,37125],[37265,37287],[37428,37451],[37593,37611],[37738,37757],[38062,38080],[38217,38236],[38374,38389],[38520,38536],[38668,38689],[38832,38854],[38998,39019],[39162,39184],[39328,39350],[39495,39518],[39664,39682],[39813,39832],[40139,40157],[40301,40320],[40465,40480],[40618,40634],[40773,40794],[40944,40966],[41117,41138],[41288,41310],[41461,41483],[41635,41658],[41811,41829],[41967,41986],[42207,42208],[42377,42377],[42392,42392],[42444,42476],[42599,42611],[42641,42658],[42966,42966],[42981,42981],[43033,43065],[43068,43068],[43077,43077],[43111,43111],[43139,43139],[43294,43297],[43346,43349],"' '",[43357,43361],"', '",[43441,43444],"'%'",[43512,43522],"'selected'",[43629,43680],"const structured = this.report.engagement.data.chart;",[44555,44603],"const structured = this.report.traffic.data.chart;",[45422,45423],[45429,45430],[50396,50397],[3648,3649],[4687,4688],[5193,5194],[8974,8975],[15312,15313],[15584,15593],[33051,33063],[33253,33254],[33322,33323],[41138,41143],[41184,41189],[41272,41272],[41324,41324],[41376,41376],[41436,41436],[41488,41488],[41540,41540],[41600,41600],[41652,41652],[41706,41706],[41778,41778],[41853,41853],[41905,41905],[41977,41977],[42044,42044],[42111,42111],[42178,42178],[0,42243],"<template>\n<div class=\"your-data-overview\">\n  <div class=\"flex-header\">\n    <h1>SNM Data Overview</h1>\n  </div>\n\n  <div class=\"nav-mobile-wrapper\">\n  <div class=\"nav-tab-wrapper\">\n    <ul class=\"nav-tabs nav-tabs-alt\">\n      <li><a class=\"tab-link\" :class=\"{'active':state=='opps'}\" @click=\"state='opps'\"><span>Opportunities</span><small>About the science opportunities on SNM</small></a></li>\n      <li><a class=\"tab-link\" :class=\"{'active':state=='engagement'}\" @click=\"state='engagement'\"><span>Engagement</span><small>How users interact with our site</small></a></li>\n      <li><a class=\"tab-link\" :class=\"{'active':state=='states'}\" @click=\"state='states'\"><span>Audience</span><small>Learn about SNM users</small></a></li>\n      <li><a class=\"tab-link\" :class=\"{'active':state=='traffic'}\" @click=\"state='traffic'\"><span>Traffic</span><small>How users get to our opportunities</small></a></li>\n      <li><a class=\"tab-link\" :class=\"{'active':state=='domain'}\" @click=\"state='domain'\"><span>Domain Insights</span><small>See how our users interact across science domains</small></a></li>\n    </ul>\n  </div>\n</div>\n\n  <aside class=\"data-update\">Date updated: {{updated_local}}</aside>\n\n  <div v-if=\"state=='opps'\">\n    <h3>Science Opportunities</h3>\n    <div id=\"opps-data\" class=\"flex\">\n        <div class=\"frow frow-top\">\n          <div class=\"big-legend large-legend\">\n            <logo-icon></logo-icon>\n            <div>\n              <h2>{{opps.total}}</h2>\n              <h3>Total Opportunities</h3>\n              <h4>All Time</h4>\n            </div>\n          </div>\n          <div class=\"bars\">\n            <div>\n              <div class=\"bar-label\"><span>Active & Published <b-tooltip label=\"Opportunities users can currently find.\" position=\"is-top\" append-to-body multilined>\n            <b-button label=\"?\" /></b-tooltip></span><span><span class=\"legend-num\">{{opps.active}}</span>/{{opps.total}}</span></div>\n              <comparison-bar :value=\"opps.active\" :max=\"opps.total\" color=\"#165E6F\" width=\"100%\" height=\"1rem\" />\n            </div>\n            <div>\n            <div class=\"bar-label\"><span>Expired <b-tooltip label=\"Opportunities no longer available.\" position=\"is-top\" append-to-body multilined>\n          <b-button label=\"?\" /></b-tooltip></span><span><span class=\"legend-num\">{{opps.inactive}}</span>/{{opps.total}}</span></div>\n            <comparison-bar :value=\"opps.inactive\" :max=\"opps.total\" color=\"#165E6F\" width=\"100%\" height=\"1rem\" />\n          </div>\n          </div>\n        </div>\n        <div class=\"frow\">\n          <div>\n            <div class=\"big-legend\">\n            <in-person-icon></in-person-icon>\n            <div>\n              <h2>{{opps.in_person}}</h2>\n              <h3>In person, in a place <b-tooltip label=\"Opportunities that individuals must go someplace. There may still be an online component, such as data entry.\" position=\"is-top\" append-to-body multilined>\n          <b-button label=\"?\" /></b-tooltip></h3>\n            </div>\n          </div>\n          <comparison-bar :value=\"opps.in_person\" :max=\"opps.total\" color=\"#165E6F\" width=\"100%\" height=\"1rem\" />\n          </div>\n          <div>\n            <div class=\"big-legend\">\n            <online-icon></online-icon>\n            <div>\n              <h2>{{opps.online}}</h2>\n              <h3>Online only <b-tooltip label=\"Opportunities that can be completed only online.\" position=\"is-top\" append-to-body multilined>\n          <b-button label=\"?\" /></b-tooltip></h3>\n            </div>\n          </div>\n          <comparison-bar :value=\"opps.online\" :max=\"opps.total\" color=\"#165E6F\" width=\"100%\" height=\"1rem\" />\n          </div> \n        </div>\n        <div class=\"frow\">\n          <div>\n            <div class=\"big-legend\">\n            <global-icon></global-icon>\n            <div>\n              <h2>{{opps.global}}</h2>\n              <h3>Global <b-tooltip label=\"Opportunities available to anyone in the world.\" position=\"is-top\" append-to-body multilined>\n          <b-button label=\"?\" /></b-tooltip></h3>\n            </div>\n          </div>\n          <comparison-bar :value=\"opps.global\" :max=\"opps.total\" color=\"#165E6F\" width=\"100%\" height=\"1rem\" />\n          </div>\n          <div>\n            <div class=\"big-legend\">\n            <region-icon></region-icon>\n            <div>\n              <h2>{{opps.regional}}</h2>\n              <h3>In a region <b-tooltip label=\"Opportunities that span an area.\" position=\"is-top\" append-to-body multilined>\n          <b-button label=\"?\" /></b-tooltip></h3>\n            </div>\n          </div>\n          <comparison-bar :value=\"opps.regional\" :max=\"opps.total\" color=\"#165E6F\" width=\"100%\" height=\"1rem\" />\n          </div> \n          <div>\n            <div class=\"big-legend\">\n            <point-icon></point-icon>\n            <div>\n              <h2>{{opps.at_point}}</h2>\n              <h3>At a point location <b-tooltip label=\"Opportunities at a specific address.\" position=\"is-top\" append-to-body multilined>\n          <b-button label=\"?\" /></b-tooltip></h3>\n            </div>\n          </div>\n          <comparison-bar :value=\"opps.at_point\" :max=\"opps.total\" color=\"#165E6F\" width=\"100%\" height=\"1rem\" />\n          </div> \n        </div>\n    </div>\n\n    <div id=\"map-explorer\">\n      <img src=\"~/assets/img/data-icons/map-explorer.jpg\" alt=\"map explorer\" />\n      <div>\n        <p>Where are Science Near Me's Opportunities?</p>\n        <nuxt-link to=\"/geo-explorer\" class=\"action-btn btn-arrow\">Visit the Map Explorer</nuxt-link>\n      </div>\n    </div>\n\n    <div class=\"data-table-wrapper attribute-table\">\n      <table class=\"data-table\">\n        <thead>\n          <tr class=\"data-table-head\">\n            <th colspan=\"5\">\n              <h3>Science Opportunities by Attributes <b-tooltip label=\"View opportunities by various data attributes.\" position=\"is-top\" append-to-body multilined><b-button label=\"?\" /></b-tooltip></h3>\n              <a :class=\"{'active':attribute=='domain'}\" @click=\"attribute='domain'\">Science Domain</a>\n              <a :class=\"{'active':attribute=='activity'}\" @click=\"attribute='activity'\">Activity Type</a>\n              <a :class=\"{'active':attribute=='indoor'}\" @click=\"attribute='indoor'\">Indoor/Outdoor</a>\n            </th>\n          </tr>\n          <tr>\n            <th colspan=\"1\">\n              <div v-if=\"attribute=='domain'\">Science Domain <b-tooltip label=\"Science domains are categories of public science defined by Science Near Me.\" position=\"is-top\" append-to-body multilined><b-button label=\"?\" /></b-tooltip></div>\n              <div v-else-if=\"attribute=='activity'\">Activity Type <b-tooltip label=\"Activity types are categories of the activity a participant will do during an opportunity.\" position=\"is-top\" append-to-body multilined><b-button label=\"?\" /></b-tooltip></div>\n              <div v-else-if=\"attribute=='indoor'\">Indoor/Outdoor <b-tooltip label=\"Where the opportunity takes place.\" position=\"is-top\" append-to-body multilined><b-button label=\"?\" /></b-tooltip></div>\n            </th>\n            <th colspan=\"2\">\n              All Time\n            </th>\n            <th colspan=\"2\">\n              Currently Live\n            </th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr v-for=\"row in opps.attribute[attribute].rows\">\n            <td class=\"narrow-column\">{{row.label}}</td>\n            <td class=\"table-num\">{{row.all}}</td>\n            <td class=\"table-bar\"><comparison-bar :value=\"row.all\" :max=\"opps.attribute[attribute].max.all\" color=\"#165E6F\" width=\"100%\" height=\"1rem\" /></td>\n            <td class=\"table-num\">{{row.current}}</td>\n            <td class=\"table-bar\"><comparison-bar :value=\"row.current\" :max=\"opps.attribute[attribute].max.current\" color=\"#165E6F\" width=\"100%\" height=\"1rem\" /></td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n\n    <div class=\"wordcloud-wrapper\">\n      <h3>Top 30 Keywords  <b-tooltip label=\"The most used keywords to describe opportunities on Science Near Me.\" position=\"is-top\" append-to-body multilined><b-button label=\"?\" /></b-tooltip></h3>\n      <word-cloud :words=\"opps.keywords\"></word-cloud>\n    </div>\n\n    <div class=\"data-table-wrapper\">\n    <table class=\"data-table\">\n      <thead>\n      <tr>\n        <th class=\"narrow-column\">Top Providers of Science Opportunities  <b-tooltip label=\"The organizations that provide the most science opportunities to Science Near Me.\" position=\"is-top\" append-to-body multilined><b-button label=\"?\" /></b-tooltip></th>\n        <th colspan=\"2\">Total Opportunities</th>\n      </tr>\n    </thead>\n    <tbody>\n      <tr v-for=\"row in opps.providers.rows\">\n        <td class=\"narrow-column\">{{row.label}}</td>\n        <td class=\"table-num\">{{row.value}}</td>\n        <td class=\"table-bar\"><comparison-bar :value=\"row.value\" :max=\"opps.providers.max\" color=\"#165E6F\" width=\"100%\" height=\"1rem\" /></td>\n      </tr>\n    </tbody>\n    </table>\n  </div>\n\n  </div> <!-- state:opps -->\n\n  <div v-else-if=\"state=='engagement'\">\n\n\n    <div class=\"flex flex2\">\n      <div id=\"snm-unique-visitors\" class=\"stack center big-legend\">\n        <telescope-icon></telescope-icon>\n        <h2>{{report.engagement.data.stats.unique_visitors}}</h2>\n        <h3>Unique SNM Visitors <b-tooltip label=\"Individual users of Science Near Me counted.\" position=\"is-top\" append-to-body multilined><b-button label=\"?\" /></b-tooltip></h3>\n      </div>\n      <!-- <div id=\"snm-accounts\" class=\"stack center big-legend\">\n        <atom-icon></atom-icon>\n        <h2>{{report.engagement.data.stats.accounts}}</h2>\n        <h3>SNM Accounts</h3>\n      </div> -->\n    </div>\n\n    <h3>Total Engagement</h3>\n    <div class=\"flex flex2 engagement-divs\">\n      <div id=\"snm-total-opp-page-views\" class=\"big-legend bl-blue\">\n          <div class=\"ll-icon\"><eye-icon></eye-icon><strong>T</strong></div>\n          <div>\n            <h2>{{Math.max(report.engagement.data.stats.opportunity_views, 6316)}}</h2> <!-- min from Google Analytics -->\n            <h3>Total Opportunity Page Views <b-tooltip label=\"Number of pages visited. One user may visit pages multiple times.\" position=\"is-top\" append-to-body multilined><b-button label=\"?\" /></b-tooltip></h3>\n          </div>\n      </div>\n      <div id=\"snm-total-opp-unique\" class=\"big-legend bl-blue\">\n        <div class=\"ll-icon\"><eye-icon></eye-icon><strong>U</strong></div>\n          <div>\n            <h2>{{Math.max(report.engagement.data.stats.opportunity_unique, 5212)}}</h2> <!-- min from Google Analytics -->\n            <h3>Unique Opportunity Page Views <b-tooltip label=\"Page views without duplication of users.\" position=\"is-top\" append-to-body multilined><b-button label=\"?\" /></b-tooltip></h3>\n          </div>\n      </div>\n    </div>\n\n    <div class=\"flex flex3  engagement-divs\">\n      <div id=\"snm-website-clicks\" class=\"big-legend bl-blue\">\n        <div class=\"ll-icon\"><link-icon></link-icon></div>\n          <div>\n            <h2>{{report.engagement.data.stats.opportunity_exits}}</h2>\n            <h3>Clicks to Websites <b-tooltip label=\"Number of times Science Near Me refers a user to the opporutnity's website.\" position=\"is-top\" append-to-body multilined><b-button label=\"?\" /></b-tooltip></h3>\n          </div>\n      </div>\n      <div id=\"snm-self-reports\" class=\"big-legend bl-blue\">\n        <div class=\"ll-icon\"><plus-icon></plus-icon></div>\n          <div>\n            <h2>{{report.engagement.data.stats.didits}}</h2>\n            <h3>Self-Reports <b-tooltip label=\"Number of times a user reports they have participated in an opportunity.\" position=\"is-top\" append-to-body multilined><b-button label=\"?\" /></b-tooltip></h3>\n          </div>\n      </div>\n      <div id=\"snm-saves\" class=\"big-legend bl-blue\">\n        <div class=\"ll-icon\"><save-icon></save-icon></div>\n          <div>\n            <h2>{{report.engagement.data.stats.saves}}</h2>\n            <h3>Saves <b-tooltip label=\"Number of times users have saved an opportunity on Science Near Me to their dashboard.\" position=\"is-top\" append-to-body multilined><b-button label=\"?\" /></b-tooltip></h3>\n          </div>\n      </div>\n    </div>\n\n    <div class=\"flex flex3 engagement-divs\">\n      <div id=\"snm-likes\" class=\"big-legend bl-blue\">\n        <div class=\"ll-icon\"><like-icon></like-icon></div>\n          <div>\n            <h2>{{report.engagement.data.stats.likes}}</h2>\n            <h3>Likes <b-tooltip label=\"Number of times a user likes an opportunity on Science Near Me.\" position=\"is-top\" append-to-body multilined><b-button label=\"?\" /></b-tooltip></h3>\n          </div>\n      </div>\n      <div id=\"snm-shares\" class=\"big-legend bl-blue\">\n        <div class=\"ll-icon\"><share-icon></share-icon></div>\n          <div>\n            <h2>{{report.engagement.data.stats.shares}}</h2>\n            <h3>Shares <b-tooltip label=\"Number of times users share an opportunity from Science Near Me.\" position=\"is-top\" append-to-body multilined><b-button label=\"?\" /></b-tooltip></h3>\n          </div>\n      </div>\n      <div id=\"snm-calendar-adds\" class=\"big-legend bl-blue\">\n        <div class=\"ll-icon calendar\"><calendar-icon></calendar-icon></div>\n          <div>\n            <h2>{{report.engagement.data.stats.calendar_adds}}</h2>\n            <h3>Calendar Adds <b-tooltip label=\"Number of times users add an opportunity to their calendar via Science Near Me.\" position=\"is-top\" append-to-body multilined><b-button label=\"?\" /></b-tooltip></h3>\n          </div>\n      </div>\n    </div>\n\n    <div class=\"data-table-wrapper\">\n    <table class=\"data-table\">\n      <thead>\n      <tr>\n        <th class=\"narrow-column\">Top 30 Searches by Keyword <b-tooltip label=\"Most used keyword searches on Science Near Me.\" position=\"is-top\" append-to-body multilined><b-button label=\"?\" /></b-tooltip></th>\n        <th colspan=\"2\">Total Searches</th>\n      </tr>\n    </thead>\n    <tbody>\n      <tr v-for=\"row in report.engagement.data.searches\">\n        <td class=\"narrow-column\">{{row.phrase}}</td>\n        <td class=\"table-num\">{{row.searches}}</td>\n        <td class=\"table-bar\"><comparison-bar :value=\"row.searches\" :max=\"report.engagement.data.search_max\" color=\"#165E6F\" width=\"100%\" height=\"1rem\" /></td>\n      </tr>\n    </tbody>\n    </table>\n  </div>\n  </div>\n\n  <div v-else-if=\"state=='states'\">\n    <div class=\"data-wrapper\">\n      <div class=\"data-head\">\n        <h3>Sex &amp; Age</h3>\n      </div>\n      <div class=\"flex flex2 sex audience\">\n      <div class=\"donuts\">\n          <div class=\"donut donut-first\">\n            <label>Female</label>\n            <div class=\"donut-wrap\">\n              <pie-chart :data=\"female_pie\" doughnut simplify />\n              <span class=\"female\">{{percent(report.demographics.sex.female.proportion)}}</span>\n            </div>\n          </div>\n          <div class=\"donut\">\n            <label>Male</label>\n            <div class=\"donut-wrap\">\n            <pie-chart :data=\"male_pie\" doughnut simplify />\n            <span class=\"male\">{{percent(report.demographics.sex.male.proportion)}}</span>\n            </div>\n          </div>\n      </div>\n      <div>\n      <div class=\"bar-viz\" v-for=\"entry in sorted_kv(report.demographics.age)\">\n        <label>{{entry[0]}}</label>\n          <comparison-bar :value=\"entry[1].male.proportion\" :max=\"entry[1].proportion\" color=\"#165E6F\" background=\"#7CB4BF\" :width=\"(entry[1].proportion * 100)*5 + '%'\" height=\"1rem\" />\n        <span>{{percent(entry[1].proportion)}}</span>\n      </div>\n    </div>\n     </div>\n    </div>\n\n    <div class=\"flex flex2 fill audience\">\n        <div class=\"push\">\n          <div class=\"data-head\">\n            <h3>Ethnicity</h3>\n          </div>\n         \n          <div class=\"bar-viz\">\n            <label>Caucasian</label>\n              <comparison-bar :value=\"report.demographics.ethnicity['Cauc.'].proportion\" :max=\"1.0\" color=\"#165E6F\" width=\"100%\" height=\"1rem\" />\n            <span>{{(report.demographics.ethnicity['Cauc.'].proportion * 100).toFixed(2)}}%</span>\n          </div>\n          <div class=\"bar-viz\">\n            <label>Hispanic</label>\n            <comparison-bar :value=\"report.demographics.ethnicity['Hisp'].proportion\" :max=\"1.0\" color=\"#165E6F\" width=\"100%\" height=\"1rem\" />\n            <span>{{(report.demographics.ethnicity['Hisp'].proportion * 100).toFixed(2)}}%</span>\n          </div>\n          <div class=\"bar-viz\">\n            <label>African American</label>\n            <comparison-bar :value=\"report.demographics.ethnicity['Afr. Am.'].proportion\" :max=\"1.0\" color=\"#165E6F\" width=\"100%\" height=\"1rem\" />\n            <span>{{(report.demographics.ethnicity['Afr. Am.'].proportion * 100).toFixed(2)}}%</span>\n          </div>\n          <div class=\"bar-viz\">\n            <label>Asian</label>\n            <comparison-bar :value=\"report.demographics.ethnicity['Asian'].proportion\" :max=\"1.0\" color=\"#165E6F\" width=\"100%\" height=\"1rem\" />\n            <span>{{(report.demographics.ethnicity['Asian'].proportion * 100).toFixed(2)}}%</span>\n          </div>\n          <div class=\"bar-viz\">\n            <label>Other</label>\n            <comparison-bar :value=\"report.demographics.ethnicity['Other'].proportion\" :max=\"1.0\" color=\"#165E6F\" width=\"100%\" height=\"1rem\" />\n            <span>{{(report.demographics.ethnicity['Other'].proportion * 100).toFixed(2)}}%</span>\n          </div>\n        </div>\n\n        <div class=\"push\">\n          <div class=\"data-head\">\n            <h3>Education</h3>\n          </div>\n          <div class=\"bar-viz\">\n            <label>No College</label>\n            <comparison-bar :value=\"report.demographics.education['No College'].proportion\" :max=\"1.0\" color=\"#165E6F\" width=\"100%\" height=\"1rem\" />\n            <span>{{(report.demographics.education['No College'].proportion * 100).toFixed(2)}}%</span>\n          </div>\n          <div class=\"bar-viz\">\n            <label>College</label>\n            <comparison-bar :value=\"report.demographics.education['College'].proportion\" :max=\"1.0\" color=\"#165E6F\" width=\"100%\" height=\"1rem\" />\n            <span>{{(report.demographics.education['College'].proportion * 100).toFixed(2)}}%</span>\n          </div>\n          <div class=\"bar-viz\">\n            <label>Grad School</label>\n            <comparison-bar :value=\"report.demographics.education['Grad. Sch.'].proportion\" :max=\"1.0\" color=\"#165E6F\" width=\"100%\" height=\"1rem\" />\n            <span>{{(report.demographics.education['Grad. Sch.'].proportion * 100).toFixed(2)}}%</span>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"flex flex2 fill audience\">\n        <div class=\"push\">\n          <div class=\"data-head\">\n            <h3>Household Income</h3>\n          </div>\n          <div class=\"bar-viz\">\n            <label>$0-50k</label>\n            <comparison-bar :value=\"report.demographics.income['$0-50k'].proportion\" :max=\"1.0\" color=\"#165E6F\" width=\"100%\" height=\"1rem\" />\n            <span>{{(report.demographics.income['$0-50k'].proportion * 100).toFixed(2)}}%</span>\n          </div>\n          <div class=\"bar-viz\">\n            <label>$50-100k</label>\n            <comparison-bar :value=\"report.demographics.income['$50-100k'].proportion\" :max=\"1.0\" color=\"#165E6F\" width=\"100%\" height=\"1rem\" />\n            <span>{{(report.demographics.income['$50-100k'].proportion * 100).toFixed(2)}}%</span>\n          </div>\n          <div class=\"bar-viz\">\n            <label>$100-150k</label>\n            <comparison-bar :value=\"report.demographics.income['$100-150k'].proportion\" :max=\"1.0\" color=\"#165E6F\" width=\"100%\" height=\"1rem\" />\n            <span>{{(report.demographics.income['$100-150k'].proportion * 100).toFixed(2)}}%</span>\n          </div>\n          <div class=\"bar-viz\">\n            <label>$150k+</label>\n            <comparison-bar :value=\"report.demographics.income['$150k+'].proportion\" :max=\"1.0\" color=\"#165E6F\" width=\"100%\" height=\"1rem\" />\n            <span>{{(report.demographics.income['$150k+'].proportion * 100).toFixed(2)}}%</span>\n          </div>\n        </div>\n\n        <div class=\"push\">\n          <div class=\"data-head\">\n            <h3>Children</h3>\n          </div>\n          <div class=\"bar-viz\">\n            <label>Has Kids</label>\n            <comparison-bar :value=\"report.demographics.children['Some Children under 17'].proportion\" :max=\"1.0\" color=\"#165E6F\" width=\"100%\" height=\"1rem\" />\n            <span>{{(report.demographics.children['Some Children under 17'].proportion * 100).toFixed(2)}}%</span>\n          </div>\n          <div class=\"bar-viz\">\n            <label>No Kids</label>\n            <comparison-bar :value=\"report.demographics.children['No Children under 17'].proportion\" :max=\"1.0\" color=\"#165E6F\" width=\"100%\" height=\"1rem\" />\n            <span>{{(report.demographics.children['No Children under 17'].proportion * 100).toFixed(2)}}%</span>\n          </div>\n        </div>\n      </div>\n\n    <choropleth-states v-if=\"selected_state === null\" :value=\"report.states.data.states\" attr=\"Unique Users\" @state=\"select_state($event)\"/>\n    <div v-else>\n      <a @click=\"selected_state = null\">← Back to US Map</a>\n      <b-select v-model=\"selected_attr\" placeholder=\"Select Data Type\">\n        <option>Unique Users</option>\n        <option>New Users</option>\n        <option>Returning Users</option>\n        <option>Total Pageviews</option>\n        <option>Unique Pageviews</option>\n        <option>Avg. Time</option>\n      </b-select>\n      <activity-regional :state=\"selected_state\" :data=\"selected_state_data\" :attr=\"selected_attr\" />\n    </div>\n\n    <div class=\"data-table-wrapper\">\n    <table class=\"data-table\">\n      <thead>\n        <tr>\n          <th>Engagement By Location</th>\n          <th colspan=\"2\">Unique Users <b-tooltip label=\"Individual users only counted once.\" position=\"is-top\" append-to-body multilined>\n          <b-button label=\"?\" />\n        </b-tooltip>\n            <a v-if=\"states_top_order == 'unique_users_desc'\" @click=\"states_top_order = 'unique_users_asc'\"><i class=\"sort sort-asc\"><sort-icon /></i></a>\n            <a v-else-if=\"states_top_order == 'unique_users_asc'\" @click=\"states_top_order = 'unique_users_desc'\"><i class=\"sort sort-desc\"><sort-icon /></i></a>\n            <a v-else @click=\"states_top_order = 'unique_users_desc'\"><i class=\"sort sortable\"><sortable-icon /></i></a>\n          </th>\n          <th colspan=\"2\">New Users <b-tooltip label=\"First time visitors.\" position=\"is-top\" append-to-body multilined>\n          <b-button label=\"?\" />\n        </b-tooltip>\n            <a v-if=\"states_top_order == 'new_users_desc'\" @click=\"states_top_order = 'new_users_asc'\"><i class=\"sort sort-asc\"><sort-icon /></i></a>\n            <a v-else-if=\"states_top_order == 'new_users_asc'\" @click=\"states_top_order = 'new_users_desc'\"><i class=\"sort sort-desc\"><sort-icon /></i></a>\n            <a v-else @click=\"states_top_order = 'new_users_desc'\"><i class=\"sort sortable\"><sortable-icon /></i></a>\n          </th>\n          <th colspan=\"2\">Returning Users <b-tooltip label=\"Visitors who have viewed more than once.\" position=\"is-top\" append-to-body multilined>\n          <b-button label=\"?\" />\n        </b-tooltip>\n            <a v-if=\"states_top_order == 'returning_users_desc'\" @click=\"states_top_order = 'returning_users_asc'\"><i class=\"sort sort-asc\"><sort-icon /></i></a>\n            <a v-else-if=\"states_top_order == 'returning_users_asc'\" @click=\"states_top_order = 'returning_users_desc'\"><i class=\"sort sort-desc\"><sort-icon /></i></a>\n            <a v-else @click=\"states_top_order = 'returning_users_desc'\"><i class=\"sort sortable\"><sortable-icon /></i></a>\n          </th>\n          <th colspan=\"2\">Total Pageviews <b-tooltip label=\"The amount of times your page was viewed.\" position=\"is-top\" append-to-body multilined>\n          <b-button label=\"?\" />\n        </b-tooltip>\n            <a v-if=\"states_top_order == 'total_pageviews_desc'\" @click=\"states_top_order = 'total_pageviews_asc'\"><i class=\"sort sort-asc\"><sort-icon /></i></a>\n            <a v-else-if=\"states_top_order == 'total_pageviews_asc'\" @click=\"states_top_order = 'total_pageviews_desc'\"><i class=\"sort sort-desc\"><sort-icon /></i></a>\n            <a v-else @click=\"states_top_order = 'total_pageviews_desc'\"><i class=\"sort sortable\"><sortable-icon /></i></a>\n          </th>\n          <th colspan=\"2\">Unique Pageviews <b-tooltip label=\"Times the page was viewed by a unique user.\" position=\"is-top\" append-to-body multilined>\n          <b-button label=\"?\" />\n        </b-tooltip>\n            <a v-if=\"states_top_order == 'unique_pageviews_desc'\" @click=\"states_top_order = 'unique_pageviews_asc'\"><i class=\"sort sort-asc\"><sort-icon /></i></a>\n            <a v-else-if=\"states_top_order == 'unique_pageviews_asc'\" @click=\"states_top_order = 'unique_pageviews_desc'\"><i class=\"sort sort-desc\"><sort-icon /></i></a>\n            <a v-else @click=\"states_top_order = 'unique_pageviews_desc'\"><i class=\"sort sortable\"><sortable-icon /></i></a>\n          </th>\n          <th colspan=\"2\">Avg. Time <b-tooltip label=\"The average time spent on your page by users.\" position=\"is-top\" append-to-body multilined>\n          <b-button label=\"?\" />\n        </b-tooltip>\n            <a v-if=\"states_top_order == 'average_time_desc'\" @click=\"states_top_order = 'average_time_asc'\"><i class=\"sort sort-asc\"><sort-icon /></i></a>\n            <a v-else-if=\"states_top_order == 'average_time_asc'\" @click=\"states_top_order = 'average_time_desc'\"><i class=\"sort sort-desc\"><sort-icon /></i></a>\n            <a v-else @click=\"states_top_order = 'average_time_desc'\"><i class=\"sort sortable\"><sortable-icon /></i></a>\n          </th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr v-for=\"row in states_top_sorted\">\n          <td v-if=\"selected_state === null\"><a @click=\"select_state(row['name'])\">{{row['name']}}</a></td>\n          <td v-else>{{row['name']}}</td>\n          <td class=\"table-num\">{{row['Unique Users']}}</td>\n          <td class=\"table-bar\"><comparison-bar :value=\"row['Unique Users']\" :max=\"states_max['Unique Users']\" color=\"#268699\" /></td>\n          <td class=\"table-num\">{{row['New Users']}}</td>\n          <td class=\"table-bar\"><comparison-bar :value=\"row['New Users']\" :max=\"states_max['New Users']\" color=\"#268699\" /></td>\n          <td class=\"table-num\">{{row['Returning Users']}}</td>\n          <td class=\"table-bar\"><comparison-bar :value=\"row['Returning Users']\" :max=\"states_max['Returning Users']\" color=\"#268699\" /></td>\n          <td class=\"table-num\">{{row['Total Pageviews']}}</td>\n          <td class=\"table-bar\"><comparison-bar :value=\"row['Total Pageviews']\" :max=\"states_max['Total Pageviews']\" color=\"#268699\" /></td>\n          <td class=\"table-num\">{{row['Unique Pageviews']}}</td>\n          <td class=\"table-bar\"><comparison-bar :value=\"row['Unique Pageviews']\" :max=\"states_max['Unique Pageviews']\" color=\"#268699\" /></td>\n          <td class=\"table-num\">{{(row['Avg. Time'] / 1000).toFixed(2)}}</td>\n          <td class=\"table-bar\"><comparison-bar :value=\"row['Avg. Time']\" :max=\"states_max['Avg. Time']\" color=\"#268699\" /></td>\n        </tr>\n      </tbody>\n    </table>\n  </div>\n\n    <div class=\"data-wrapper crush\">\n\n      <div class=\"data-head\">\n        <h3>Technology</h3>\n      </div>\n\n    <pie-chart :data=\"technology_pie\" doughnut />\n    </div>\n\n    <div class=\"data-table-wrapper\">\n\n    <table class=\"data-table\">\n      <thead>\n        <tr>\n          <th>Engagement By Device Type</th>\n          <th colspan=\"2\">Unique Users\n            <b-tooltip label=\"Individual users only counted once.\" position=\"is-top\" append-to-body multilined>\n              <b-button label=\"?\" />\n            </b-tooltip>\n            <a v-if=\"technology_top_order == 'unique_users_desc'\" @click=\"technology_top_order = 'unique_users_asc'\"><i class=\"sort sort-asc\"><sort-icon /></i></a>\n            <a v-else-if=\"technology_top_order == 'unique_users_asc'\" @click=\"technology_top_order = 'unique_users_desc'\"><i class=\"sort sort-desc\"><sort-icon /></i></a>\n            <a v-else @click=\"technology_top_order = 'unique_users_desc'\"><i class=\"sort sortable\"><sortable-icon /></i></a>\n          </th>\n          <th colspan=\"2\">New Users\n            <b-tooltip label=\"First time visitors.\" position=\"is-top\" append-to-body multilined>\n              <b-button label=\"?\" />\n            </b-tooltip>\n            <a v-if=\"technology_top_order == 'new_users_desc'\" @click=\"technology_top_order = 'new_users_asc'\"><i class=\"sort sort-asc\"><sort-icon /></i></a>\n            <a v-else-if=\"technology_top_order == 'new_users_asc'\" @click=\"technology_top_order = 'new_users_desc'\"><i class=\"sort sort-desc\"><sort-icon /></i></a>\n            <a v-else @click=\"technology_top_order = 'new_users_desc'\"><i class=\"sort sortable\"><sortable-icon /></i></a>\n          </th>\n          <th colspan=\"2\">Returning Users\n            <b-tooltip label=\"Visitors who have viewed more than once.\" position=\"is-top\" append-to-body multilined>\n              <b-button label=\"?\" />\n            </b-tooltip>\n            <a v-if=\"technology_top_order == 'returning_users_desc'\" @click=\"technology_top_order = 'returning_users_asc'\"><i class=\"sort sort-asc\"><sort-icon /></i></a>\n            <a v-else-if=\"technology_top_order == 'returning_users_asc'\" @click=\"technology_top_order = 'returning_users_desc'\"><i class=\"sort sort-desc\"><sort-icon /></i></a>\n            <a v-else @click=\"technology_top_order = 'returning_users_desc'\"><i class=\"sort sortable\"><sortable-icon /></i></a>\n          </th>\n          <th colspan=\"2\">Total Pageviews\n            <b-tooltip label=\"The amount of times your page was viewed.\" position=\"is-top\" append-to-body multilined>\n              <b-button label=\"?\" />\n            </b-tooltip>\n            <a v-if=\"technology_top_order == 'total_pageviews_desc'\" @click=\"technology_top_order = 'total_pageviews_asc'\"><i class=\"sort sort-asc\"><sort-icon /></i></a>\n            <a v-else-if=\"technology_top_order == 'total_pageviews_asc'\" @click=\"technology_top_order = 'total_pageviews_desc'\"><i class=\"sort sort-desc\"><sort-icon /></i></a>\n            <a v-else @click=\"technology_top_order = 'total_pageviews_desc'\"><i class=\"sort sortable\"><sortable-icon /></i></a>\n          </th>\n          <th colspan=\"2\">Unique Pageviews\n            <b-tooltip label=\"Times the page was viewed by a unique user.\" position=\"is-top\" append-to-body multilined>\n              <b-button label=\"?\" />\n            </b-tooltip>\n            <a v-if=\"technology_top_order == 'unique_pageviews_desc'\" @click=\"technology_top_order = 'unique_pageviews_asc'\"><i class=\"sort sort-asc\"><sort-icon /></i></a>\n            <a v-else-if=\"technology_top_order == 'unique_pageviews_asc'\" @click=\"technology_top_order = 'unique_pageviews_desc'\"><i class=\"sort sort-desc\"><sort-icon /></i></a>\n            <a v-else @click=\"technology_top_order = 'unique_pageviews_desc'\"><i class=\"sort sortable\"><sortable-icon /></i></a>\n          </th>\n          <th colspan=\"2\">Avg. Time\n            <b-tooltip label=\"The average time spent on your page by users.\" position=\"is-top\" append-to-body multilined>\n              <b-button label=\"?\" />\n            </b-tooltip>\n            <a v-if=\"technology_top_order == 'average_time_desc'\" @click=\"technology_top_order = 'average_time_asc'\"><i class=\"sort sort-asc\"><sort-icon /></i></a>\n            <a v-else-if=\"technology_top_order == 'average_time_asc'\" @click=\"technology_top_order = 'average_time_desc'\"><i class=\"sort sort-desc\"><sort-icon /></i></a>\n            <a v-else @click=\"technology_top_order = 'average_time_desc'\"><i class=\"sort sortable\"><sortable-icon /></i></a>\n          </th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr v-for=\"row in technology_top_sorted\">\n          <td>{{row['name']}}</td>\n          <td>{{row['Unique Users']}}</td>\n          <td><comparison-bar :value=\"row['Unique Users']\" :max=\"report.technology.data.max['Unique Users']\" color=\"#268699\" /></td>\n          <td>{{row['New Users']}}</td>\n          <td><comparison-bar :value=\"row['New Users']\" :max=\"report.technology.data.max['New Users']\" color=\"#268699\" /></td>\n          <td>{{row['Returning Users']}}</td>\n          <td><comparison-bar :value=\"row['Returning Users']\" :max=\"report.technology.data.max['Returning Users']\" color=\"#268699\" /></td>\n          <td>{{row['Total Pageviews']}}</td>\n          <td><comparison-bar :value=\"row['Total Pageviews']\" :max=\"report.technology.data.max['Total Pageviews']\" color=\"#268699\" /></td>\n          <td>{{row['Unique Pageviews']}}</td>\n          <td><comparison-bar :value=\"row['Unique Pageviews']\" :max=\"report.technology.data.max['Unique Pageviews']\" color=\"#268699\" /></td>\n          <td>{{(row['Avg. Time'] / 1000).toFixed(2)}}</td>\n          <td><comparison-bar :value=\"row['Avg. Time']\" :max=\"report.technology.data.max['Avg. Time']\" color=\"#268699\" /></td>\n        </tr>\n      </tbody>\n    </table>\n  </div>\n  </div>\n\n  <div v-else-if=\"state=='traffic'\">\n\n    <div class=\"data-wrapper\">\n      <div class=\"data-header\">\n        <div class=\"big-legend bl-blue\">\n          <div class=\"ll-icon\"><eye-icon></eye-icon></div>\n          <div>\n            <h2># (Total Unique Users during time period)</h2>\n            <h3>Users</h3>\n            \n          </div>\n        </div>\n        <div class=\"ll-legend\">\n              <div><span class=\"dark-blue\"></span> Unique</div>\n              <div><span class=\"light-blue\"></span> New</div> \n              <div><span class=\"light-blue\"></span> Returning</div> \n            </div>\n        </div>\n      <client-only>\n        <line-chart\n          :rows=\"report.traffic.data.chart\"\n          :xaxis=\"d => new Date(d.date)\"\n          :yaxes=\"['Unique', 'New', 'Returning']\"\n          :colors=\"['#268699', '#868686', '#BFDCE2']\"\n          />\n      </client-only>\n    </div>\n\n    <div class=\"data-wrapper crush\">\n      <div class=\"data-head\">\n          <h3>Referral Sources  <b-tooltip label=\"How users arrive to Science Near Me before finding your opportunity.\" position=\"is-top\" append-to-body multilined><b-button label=\"?\" /></b-tooltip></h3>\n        </div>\n    <pie-chart :data=\"report.traffic.data.pie\" />\n    </div>\n\n    <div class=\"data-table-wrapper\">\n\n    <!-- <table class=\"data-table\"> -->\n    <!--   <thead> -->\n    <!--     <tr> -->\n    <!--       <th>Top Referrers</th> -->\n    <!--       <th colspan=\"2\">Unique Users <b-tooltip label=\"Individual users only counted once.\" position=\"is-top\" append-to-body multilined> -->\n    <!--       <b-button label=\"?\" /> -->\n    <!--     </b-tooltip> -->\n    <!--         <a v-if=\"traffic_top_order == 'unique_users_desc'\" @click=\"traffic_top_order = 'unique_users_asc'\"><i class=\"sort sort-asc\"><sort-icon /></i></a> -->\n    <!--         <a v-else-if=\"traffic_top_order == 'unique_users_asc'\" @click=\"traffic_top_order = 'unique_users_desc'\"><i class=\"sort sort-desc\"><sort-icon /></i></a> -->\n    <!--         <a v-else @click=\"traffic_top_order = 'unique_users_desc'\"><i class=\"sort sortable\"><sortable-icon /></i></a> -->\n    <!--       </th> -->\n    <!--       <th colspan=\"2\">New Users <b-tooltip label=\"First time visitors.\" position=\"is-top\" append-to-body multilined> -->\n    <!--       <b-button label=\"?\" /> -->\n    <!--     </b-tooltip> -->\n    <!--         <a v-if=\"traffic_top_order == 'new_users_desc'\" @click=\"traffic_top_order = 'new_users_asc'\"><i class=\"sort sort-asc\"><sort-icon /></i></a> -->\n    <!--         <a v-else-if=\"traffic_top_order == 'new_users_asc'\" @click=\"traffic_top_order = 'new_users_desc'\"><i class=\"sort sort-desc\"><sort-icon /></i></a> -->\n    <!--         <a v-else @click=\"traffic_top_order = 'new_users_desc'\"><i class=\"sort sortable\"><sortable-icon /></i></a> -->\n    <!--       </th> -->\n    <!--       <th colspan=\"2\">Returning Users <b-tooltip label=\"Visitors who have viewed more than once.\" position=\"is-top\" append-to-body multilined> -->\n    <!--       <b-button label=\"?\" /> -->\n    <!--     </b-tooltip> -->\n    <!--         <a v-if=\"traffic_top_order == 'returning_users_desc'\" @click=\"traffic_top_order = 'returning_users_asc'\"><i class=\"sort sort-asc\"><sort-icon /></i></a> -->\n    <!--         <a v-else-if=\"traffic_top_order == 'returning_users_asc'\" @click=\"traffic_top_order = 'returning_users_desc'\"><i class=\"sort sort-desc\"><sort-icon /></i></a> -->\n    <!--         <a v-else @click=\"traffic_top_order = 'returning_users_desc'\"><i class=\"sort sortable\"><sortable-icon /></i></a> -->\n    <!--       </th> -->\n    <!--       <th colspan=\"2\">Total Pageviews <b-tooltip label=\"The amount of times your page was viewed.\" position=\"is-top\" append-to-body multilined> -->\n    <!--       <b-button label=\"?\" /> -->\n    <!--     </b-tooltip> -->\n    <!--         <a v-if=\"traffic_top_order == 'total_pageviews_desc'\" @click=\"traffic_top_order = 'total_pageviews_asc'\"><i class=\"sort sort-asc\"><sort-icon /></i></a> -->\n    <!--         <a v-else-if=\"traffic_top_order == 'total_pageviews_asc'\" @click=\"traffic_top_order = 'total_pageviews_desc'\"><i class=\"sort sort-desc\"><sort-icon /></i></a> -->\n    <!--         <a v-else @click=\"traffic_top_order = 'total_pageviews_desc'\"><i class=\"sort sortable\"><sortable-icon /></i></a> -->\n    <!--       </th> -->\n    <!--       <th colspan=\"2\">Unique Pageviews <b-tooltip label=\"Times the page was viewed by a unique user.\" position=\"is-top\" append-to-body multilined> -->\n    <!--       <b-button label=\"?\" /> -->\n    <!--     </b-tooltip> -->\n    <!-- 